{
  "name": "lingoblox-android",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build:www": "node scripts/build-www.mjs",
    "sync": "npm run build:www && npx cap sync android",
    "open": "npx cap open android",
    "bundle": "npm run sync && cd android && ./gradlew bundleRelease",
    "apk": "npm run sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor-community/admob": "^8.2.1",
    "capacitor-plugin-cdv-purchase": "^13.19.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "esbuild": "^0.25.0"
  }
}
